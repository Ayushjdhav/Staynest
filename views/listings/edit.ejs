<% layout("/layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-4">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
      <div class="mb-4 pb-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
          <h2 class="fw-bold mb-1">Edit Stay</h2>
          <p class="text-muted mb-0">Update property details, capacity, pricing, and amenities.</p>
        </div>
        <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
          <i class="fa-solid fa-arrow-left me-1"></i> Back
        </a>
      </div>

      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-bold">Property Title</label>
          <input type="text" name="listing[title]" id="title" value="<%= listing.title %>" class="form-control rounded-3 py-2" required>
          <div class="invalid-feedback">Please enter a property title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-bold">Description</label>
          <textarea name="listing[description]" id="description" rows="4" class="form-control rounded-3" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a detailed description.</div>
        </div>

        <!-- Current Image Preview & Upload -->
        <div class="mb-3">
          <label class="form-label fw-bold">Photos</label>
          <div class="d-flex align-items-center gap-3 p-3 bg-subtle rounded-3 border">
            <img src="<%= originalImageUrl %>" class="rounded-3 shadow-sm" style="width: 140px; height: 95px; object-fit: cover;" alt="Current photo"
              onerror="this.src='https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80'">
            <div class="flex-grow-1">
              <label for="images" class="form-label small fw-bold">Upload new photos to replace current</label>
              <input type="file" name="listing[images]" id="images" class="form-control rounded-3" accept="image/jpeg,image/png,image/webp" multiple>
              <div class="form-text small">Select up to 5 photos. Leave empty to keep existing images.</div>
            </div>
          </div>
        </div>

        <!-- Category, Property Type, Room Type -->
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Category</label>
            <select name="listing[category]" class="form-select rounded-3">
              <% const categories = ["trending", "villas", "rooms", "iconic-cities", "mountains", "amazing-views", "beach", "camping", "castles", "arctic", "farms", "pools", "forest"]; %>
              <% for (let cat of categories) { %>
                <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %> class="text-capitalize"><%= cat %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Property Type</label>
            <select name="listing[propertyType]" class="form-select rounded-3">
              <% const pTypes = ["apartment", "villa", "cabin", "cottage", "house", "hotel", "chalet", "resort", "treehouse"]; %>
              <% for (let pt of pTypes) { %>
                <option value="<%= pt %>" <%= listing.propertyType === pt ? 'selected' : '' %> class="text-capitalize"><%= pt %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Room Type</label>
            <select name="listing[roomType]" class="form-select rounded-3">
              <option value="entire_place" <%= listing.roomType === 'entire_place' ? 'selected' : '' %>>Entire place</option>
              <option value="private_room" <%= listing.roomType === 'private_room' ? 'selected' : '' %>>Private room</option>
              <option value="shared_room" <%= listing.roomType === 'shared_room' ? 'selected' : '' %>>Shared room</option>
            </select>
          </div>
        </div>

        <!-- Price, Location, Country -->
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label for="price" class="form-label fw-bold">Price per night (₹)</label>
            <input type="number" name="listing[price]" id="price" value="<%= listing.price %>" class="form-control rounded-3" min="0" required>
            <div class="invalid-feedback">Valid price required.</div>
          </div>
          <div class="col-md-4">
            <label for="location" class="form-label fw-bold">City / Location</label>
            <input type="text" name="listing[location]" id="location" value="<%= listing.location %>" class="form-control rounded-3" required>
            <div class="invalid-feedback">Location required.</div>
          </div>
          <div class="col-md-4">
            <label for="country" class="form-label fw-bold">Country</label>
            <input type="text" name="listing[country]" id="country" value="<%= listing.country %>" class="form-control rounded-3" required>
            <div class="invalid-feedback">Country required.</div>
          </div>
        </div>

        <!-- Capacity Specs -->
        <div class="row g-3 mb-3">
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Max Guests</label>
            <input type="number" name="listing[maxGuests]" class="form-control rounded-3" value="<%= listing.maxGuests || 2 %>" min="1" required>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Bedrooms</label>
            <input type="number" name="listing[bedrooms]" class="form-control rounded-3" value="<%= listing.bedrooms || 1 %>" min="1" required>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Beds</label>
            <input type="number" name="listing[beds]" class="form-control rounded-3" value="<%= listing.beds || 1 %>" min="1" required>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Bathrooms</label>
            <input type="number" step="0.5" name="listing[bathrooms]" class="form-control rounded-3" value="<%= listing.bathrooms || 1 %>" min="0.5" required>
          </div>
        </div>

        <!-- Fees & Cancellation -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label fw-bold small">Cleaning Fee (₹)</label>
            <input type="number" name="listing[cleaningFee]" class="form-control rounded-3" value="<%= listing.cleaningFee || 500 %>" min="0">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold small">Cancellation Policy</label>
            <select name="listing[cancellationPolicy]" class="form-select rounded-3">
              <option value="flexible" <%= listing.cancellationPolicy === 'flexible' ? 'selected' : '' %>>Flexible (Full refund up to 1 day prior)</option>
              <option value="moderate" <%= listing.cancellationPolicy === 'moderate' ? 'selected' : '' %>>Moderate (Full refund up to 5 days prior)</option>
              <option value="strict" <%= listing.cancellationPolicy === 'strict' ? 'selected' : '' %>>Strict (50% refund up to 7 days prior)</option>
            </select>
          </div>
        </div>

        <!-- Amenities Multi-Select -->
        <div class="mb-4">
          <label class="form-label fw-bold">Amenities Offered</label>
          <div class="row row-cols-2 row-cols-md-3 g-2">
            <% const allPossibleAmenities = [
              { id: 'wifi', name: 'Fast Wifi' },
              { id: 'pool', name: 'Swimming Pool' },
              { id: 'ac', name: 'Air Conditioning' },
              { id: 'kitchen', name: 'Kitchen' },
              { id: 'free_parking', name: 'Free Parking' },
              { id: 'hot_tub', name: 'Hot Tub / Jacuzzi' },
              { id: 'pet_friendly', name: 'Pet Friendly' },
              { id: 'beach_access', name: 'Beach Access' },
              { id: 'dedicated_workspace', name: 'Dedicated Workspace' },
              { id: 'tv', name: 'Smart TV' },
            ]; %>
            <% const currentAmenities = listing.amenities || []; %>
            <% for (let a of allPossibleAmenities) { %>
              <div class="col">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a.id %>" id="edit-am-<%= a.id %>" <%= currentAmenities.includes(a.id) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="edit-am-<%= a.id %>"><%= a.name %></label>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="d-grid mt-4">
          <button class="btn btn-primary py-3 rounded-pill fw-bold fs-5 shadow">
            <i class="fa-solid fa-check me-2"></i> Save Stay Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
