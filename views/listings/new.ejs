<% layout("/layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-4">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
      <div class="mb-4 pb-3 border-bottom">
        <h2 class="fw-bold mb-1">Host a Stay on StayNest</h2>
        <p class="text-muted">List your property with authentic details, verified amenities, and high-quality photos.</p>
      </div>

      <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-bold">Property Title</label>
          <input type="text" name="listing[title]" id="title" placeholder="e.g. Luxurious Oceanfront Villa with Infinity Pool" class="form-control rounded-3 py-2" required>
          <div class="invalid-feedback">Please enter a property title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-bold">Description</label>
          <textarea name="listing[description]" id="description" rows="4" placeholder="Describe the space, architecture, views, and unique features..." class="form-control rounded-3" required></textarea>
          <div class="invalid-feedback">Please enter a detailed description.</div>
        </div>

        <!-- Category, Property Type, Room Type -->
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Category</label>
            <select name="listing[category]" class="form-select rounded-3" required>
              <option value="trending">Trending</option>
              <option value="villas">Villas</option>
              <option value="rooms">Rooms</option>
              <option value="iconic-cities">Iconic Cities</option>
              <option value="mountains">Mountains</option>
              <option value="amazing-views">Amazing Views</option>
              <option value="beach">Beach</option>
              <option value="camping">Camping</option>
              <option value="castles">Heritage</option>
              <option value="arctic">Arctic</option>
              <option value="farms">Countryside</option>
              <option value="pools">Pools</option>
              <option value="forest">Nature & Cabins</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Property Type</label>
            <select name="listing[propertyType]" class="form-select rounded-3">
              <option value="apartment">Apartment</option>
              <option value="villa">Villa</option>
              <option value="cabin">Cabin</option>
              <option value="cottage">Cottage</option>
              <option value="house">House</option>
              <option value="hotel">Boutique Hotel</option>
              <option value="chalet">Chalet</option>
              <option value="treehouse">Treehouse</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Room Type</label>
            <select name="listing[roomType]" class="form-select rounded-3">
              <option value="entire_place">Entire place</option>
              <option value="private_room">Private room</option>
              <option value="shared_room">Shared room</option>
            </select>
          </div>
        </div>

        <!-- Image Upload -->
        <div class="mb-3">
          <label for="images" class="form-label fw-bold">Property Photos</label>
          <input type="file" name="listing[images]" id="images" class="form-control rounded-3" accept="image/jpeg,image/png,image/webp" multiple required>
          <div class="form-text">Upload 1–5 JPEG, PNG, or WebP photos (10 MB each). The first photo will serve as the cover image.</div>
        </div>

        <!-- Price, Location, Country -->
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label for="price" class="form-label fw-bold">Price per night (₹)</label>
            <input type="number" name="listing[price]" id="price" placeholder="12000" class="form-control rounded-3" min="0" required>
            <div class="invalid-feedback">Valid price required.</div>
          </div>
          <div class="col-md-4">
            <label for="location" class="form-label fw-bold">City / Location</label>
            <input type="text" name="listing[location]" id="location" placeholder="e.g. North Goa" class="form-control rounded-3" required>
            <div class="invalid-feedback">Location required.</div>
          </div>
          <div class="col-md-4">
            <label for="country" class="form-label fw-bold">Country</label>
            <input type="text" name="listing[country]" id="country" placeholder="e.g. India" class="form-control rounded-3" required>
            <div class="invalid-feedback">Country required.</div>
          </div>
        </div>

        <!-- Capacity Specs -->
        <div class="row g-3 mb-3">
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Max Guests</label>
            <input type="number" name="listing[maxGuests]" class="form-control rounded-3" value="4" min="1">
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Bedrooms</label>
            <input type="number" name="listing[bedrooms]" class="form-control rounded-3" value="2" min="1">
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Beds</label>
            <input type="number" name="listing[beds]" class="form-control rounded-3" value="2" min="1">
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label fw-bold small">Bathrooms</label>
            <input type="number" step="0.5" name="listing[bathrooms]" class="form-control rounded-3" value="2" min="0.5">
          </div>
        </div>

        <!-- Fees & Cancellation -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label fw-bold small">Cleaning Fee (₹)</label>
            <input type="number" name="listing[cleaningFee]" class="form-control rounded-3" value="500" min="0">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold small">Cancellation Policy</label>
            <select name="listing[cancellationPolicy]" class="form-select rounded-3">
              <option value="flexible" selected>Flexible (Full refund up to 1 day prior)</option>
              <option value="moderate">Moderate (Full refund up to 5 days prior)</option>
              <option value="strict">Strict (50% refund up to 7 days prior)</option>
            </select>
          </div>
        </div>

        <!-- Amenities Multi-Select -->
        <div class="mb-4">
          <label class="form-label fw-bold">Amenities Included</label>
          <div class="row row-cols-2 row-cols-md-3 g-2">
            <% const amList = [
              { id: 'wifi', name: 'Fast Wifi' },
              { id: 'pool', name: 'Swimming Pool' },
              { id: 'ac', name: 'Air Conditioning' },
              { id: 'kitchen', name: 'Kitchen' },
              { id: 'free_parking', name: 'Free Parking' },
              { id: 'hot_tub', name: 'Hot Tub' },
              { id: 'pet_friendly', name: 'Pet Friendly' },
              { id: 'beach_access', name: 'Beach Access' },
              { id: 'dedicated_workspace', name: 'Dedicated Workspace' },
            ]; %>
            <% for (let a of amList) { %>
              <div class="col">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a.id %>" id="new-am-<%= a.id %>" checked>
                  <label class="form-check-label small" for="new-am-<%= a.id %>"><%= a.name %></label>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <div class="d-grid mt-4">
          <button class="btn btn-primary py-3 rounded-pill fw-bold fs-5 shadow">
            <i class="fa-solid fa-plus me-2"></i> Publish Stay
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
