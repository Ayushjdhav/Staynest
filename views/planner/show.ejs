<% layout("/layouts/boilerplate.ejs") -%>

<div class="container my-4">
  <!-- ITINERARY HEADER -->
  <div class="p-4 p-md-5 rounded-4 mb-4 text-white shadow-md" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-primary rounded-pill px-3 py-2 text-uppercase fw-bold">
            <i class="fa-solid fa-wand-magic-sparkles me-1 text-warning"></i> AI Generated Itinerary
          </span>
          <span class="badge bg-secondary rounded-pill px-3 py-2">
            <%= itinerary.days %> Days in <%= itinerary.destination %>
          </span>
        </div>
        <h1 class="display-6 fw-bold text-white mb-2"><%= itinerary.title %></h1>
        <p class="lead opacity-75 mb-0" style="max-width: 850px;"><%= itinerary.summary %></p>
      </div>

      <div class="d-flex gap-2">
        <a href="/planner" class="btn btn-outline-light rounded-pill px-3">
          <i class="fa-solid fa-plus me-1"></i> Plan Another
        </a>
      </div>
    </div>
  </div>

  <div class="row g-5">
    <!-- LEFT: DAY-BY-DAY ITINERARY TIMELINE -->
    <div class="col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Daily Schedule</h3>
        <span class="text-muted small">Estimated Daily Budget: ₹<%= itinerary.dailyPlans && itinerary.dailyPlans[0] ? itinerary.dailyPlans[0].estimatedDailyCost.toLocaleString("en-IN") : '2,500' %></span>
      </div>

      <!-- Day Tabs -->
      <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="pills-tab" role="tablist">
        <% itinerary.dailyPlans.forEach((plan, index) => { %>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold <%= index === 0 ? 'active' : '' %>" id="pills-day-<%= plan.day %>-tab"
              data-bs-toggle="pill" data-bs-target="#pills-day-<%= plan.day %>" type="button" role="tab">
              Day <%= plan.day %>
            </button>
          </li>
        <% }); %>
      </ul>

      <!-- Day Tab Contents -->
      <div class="tab-content" id="pills-tabContent">
        <% itinerary.dailyPlans.forEach((plan, index) => { %>
          <div class="tab-pane fade <%= index === 0 ? 'show active' : '' %>" id="pills-day-<%= plan.day %>" role="tabpanel">
            <h5 class="fw-bold text-primary mb-3">
              <i class="fa-solid fa-compass me-2"></i><%= plan.title %>
            </h5>

            <!-- Morning -->
            <div class="card p-3 rounded-4 border mb-3 bg-subtle">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold">🌅 Morning</span>
                <span class="text-muted small">Est. ₹<%= plan.morning.estimatedCost || 500 %></span>
              </div>
              <h6 class="fw-bold fs-5 mb-1"><%= plan.morning.activity %></h6>
              <p class="text-muted small mb-2">📍 <%= plan.morning.location %></p>
              <p class="mb-0 text-secondary"><%= plan.morning.description %></p>
            </div>

            <!-- Afternoon -->
            <div class="card p-3 rounded-4 border mb-3 bg-subtle">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-primary rounded-pill px-3 py-1 fw-bold">☀️ Afternoon</span>
                <span class="text-muted small">Est. ₹<%= plan.afternoon.estimatedCost || 800 %></span>
              </div>
              <h6 class="fw-bold fs-5 mb-1"><%= plan.afternoon.activity %></h6>
              <p class="text-muted small mb-2">📍 <%= plan.afternoon.location %></p>
              <p class="mb-0 text-secondary"><%= plan.afternoon.description %></p>
            </div>

            <!-- Evening -->
            <div class="card p-3 rounded-4 border mb-3 bg-subtle">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-dark rounded-pill px-3 py-1 fw-bold">🌙 Evening</span>
                <span class="text-muted small">Est. ₹<%= plan.evening.estimatedCost || 1200 %></span>
              </div>
              <h6 class="fw-bold fs-5 mb-1"><%= plan.evening.activity %></h6>
              <p class="text-muted small mb-2">📍 <%= plan.evening.location %></p>
              <p class="mb-0 text-secondary"><%= plan.evening.description %></p>
            </div>

            <!-- Dining Recommendations for the Day -->
            <% if (plan.mealRecommendations && plan.mealRecommendations.length > 0) { %>
              <div class="card p-3 rounded-4 bg-subtle border-0 mb-4">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-utensils text-primary me-2"></i>Curated Food & Dining</h6>
                <div class="row row-cols-1 row-cols-md-2 g-3">
                  <% for (let meal of plan.mealRecommendations) { %>
                    <div class="col">
                      <div class="p-3 bg-white rounded-3 border h-100">
                        <div class="d-flex justify-content-between">
                          <span class="badge bg-light text-dark fw-bold"><%= meal.mealType %></span>
                          <span class="text-success fw-bold small"><%= meal.priceRange %></span>
                        </div>
                        <div class="fw-bold mt-2 text-dark"><%= meal.name %></div>
                        <div class="small text-muted mb-1"><%= meal.cuisine %></div>
                        <div class="small text-secondary"><%= meal.description %></div>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>

      <!-- Packing & Tips Section -->
      <div class="row g-4 mt-2">
        <div class="col-md-6">
          <div class="card p-4 rounded-4 border-0 shadow-sm bg-subtle h-100">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-suitcase-rolling text-primary me-2"></i>Packing Checklist</h5>
            <ul class="list-unstyled mb-0">
              <% (itinerary.packingList || ["Walking shoes", "Camera", "Universal adapter", "Sunscreen"]).forEach(item => { %>
                <li class="mb-2 d-flex align-items-center gap-2">
                  <i class="fa-solid fa-circle-check text-success"></i>
                  <span><%= item %></span>
                </li>
              <% }); %>
            </ul>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card p-4 rounded-4 border-0 shadow-sm bg-subtle h-100">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-lightbulb text-warning me-2"></i>Local Insider Tips</h5>
            <ul class="list-unstyled mb-0">
              <% (itinerary.localTips || ["Book popular spots online", "Use public transit", "Taste local delicacies"]).forEach(tip => { %>
                <li class="mb-2 d-flex align-items-start gap-2">
                  <i class="fa-solid fa-arrow-right text-muted mt-1"></i>
                  <span><%= tip %></span>
                </li>
              <% }); %>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: RECOMMENDED STAYNEST STAYS -->
    <div class="col-lg-4">
      <div class="sticky-top" style="top: 100px;">
        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
          <span>Matched StayNest Stays</span>
          <span class="badge bg-primary-subtle text-primary rounded-pill fs-6"><%= itinerary.recommendedListings.length %></span>
        </h4>

        <% if (itinerary.recommendedListings && itinerary.recommendedListings.length > 0) { %>
          <% for (let rec of itinerary.recommendedListings) { %>
            <% if (rec.listing) { %>
              <div class="card border rounded-4 overflow-hidden shadow-sm mb-4">
                <div class="position-relative">
                  <img src="<%= rec.listing.displayImage || (rec.listing.image && rec.listing.image.url) %>" class="card-img-top" style="height: 180px; object-fit: cover;" alt="<%= rec.listing.title %>"
                    onerror="this.src='https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80'">
                  <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 text-white rounded-pill px-3 py-2 fw-bold">
                    <i class="fa-solid fa-sparkles text-warning me-1"></i> <%= rec.matchScore %>% Match
                  </span>
                </div>
                <div class="card-body p-3">
                  <h6 class="card-title fw-bold mb-1"><%= rec.listing.title %></h6>
                  <p class="text-muted small mb-2">📍 <%= rec.listing.location %>, <%= rec.listing.country %></p>
                  
                  <!-- Why Recommended Box -->
                  <div class="p-2 rounded-3 bg-primary bg-opacity-10 border border-primary-subtle small text-primary mb-3">
                    <strong>Why it matches:</strong> <%= rec.whyRecommended %>
                  </div>

                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <span class="fw-bold fs-6">₹ <%= rec.listing.price.toLocaleString("en-IN") %></span>
                      <span class="text-muted small"> / night</span>
                    </div>
                    <a href="/listings/<%= rec.listing._id %>" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                      View Stay
                    </a>
                  </div>
                </div>
              </div>
            <% } %>
          <% } %>
        <% } else { %>
          <div class="card p-4 rounded-4 text-center border-0 bg-subtle">
            <p class="text-muted mb-2">Explore our collection of stays for this destination.</p>
            <a href="/listings?search=<%= encodeURIComponent(itinerary.destination) %>" class="btn btn-outline-primary rounded-pill">
              Browse <%= itinerary.destination %> Stays
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
