<nav class="navbar navbar-expand-lg sticky-top shadow-sm" aria-label="Main Navigation">
  <div class="container">
    <!-- StayNest Logo & Brand -->
    <a class="navbar-brand" href="/listings">
      <div class="brand-icon-box">
        <i class="fa-solid fa-house-chimney-window"></i>
      </div>
      <span>StayNest<span class="brand-dot">.</span></span>
    </a>

    <!-- Mobile Toggle -->
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Left Navigation -->
      <ul class="navbar-nav me-auto align-items-center mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link" href="/listings">
            <i class="fa-solid fa-compass me-1 text-primary"></i> Explore Stays
          </a>
        </li>
        <li class="nav-item ms-lg-1">
          <a class="nav-link" href="/planner">
            <i class="fa-solid fa-route me-1 text-teal"></i> AI Itineraries
          </a>
        </li>
        <li class="nav-item ms-lg-2">
          <button type="button" class="btn-ai-planner" onclick="const t = document.getElementById('ai-widget-toggle'); if(t) t.click();">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Ask AI
          </button>
        </li>
      </ul>

      <!-- Navbar Search Bar (Discovery focused) -->
      <form class="search-form mx-auto my-2 my-lg-0" method="GET" action="/listings">
        <input class="search-inp" type="search" name="search"
          value="<%= typeof search !== 'undefined' ? search : '' %>"
          placeholder="Search destinations, cities, stays..." aria-label="Search destinations">
        <button class="btn-search" type="submit" aria-label="Submit search">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>

      <!-- Right Menu -->
      <ul class="navbar-nav ms-auto align-items-center">
        <% if (locals.currUser) { %>
          <% if (currUser.role === 'host' || currUser.role === 'admin') { %>
            <li class="nav-item">
              <a class="nav-link fw-bold text-primary" href="/host/dashboard">
                <i class="fa-solid fa-chart-line me-1"></i> Host Dashboard
              </a>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/host/become-a-host">
                <i class="fa-solid fa-house-chimney-medical me-1 text-muted"></i> Host your stay
              </a>
            </li>
          <% } %>

          <li class="nav-item">
            <a class="nav-link" href="/wishlists" title="Saved Stays">
              <i class="fa-regular fa-heart me-1"></i> Saved
            </a>
          </li>

          <!-- Notifications Bell -->
          <li class="nav-item me-2">
            <a class="notification-bell d-inline-block" href="/notifications" title="Notifications">
              <i class="fa-regular fa-bell"></i>
              <% if (locals.unreadCount && unreadCount > 0) { %>
                <span class="notification-badge" id="nav-notif-badge"><%= unreadCount %></span>
              <% } %>
            </a>
          </li>

          <!-- User Profile & Dropdown -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-1 border rounded-pill px-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-bars ms-1 text-muted"></i>
              <img src="<%= currUser.avatar && currUser.avatar.url ? currUser.avatar.url : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100' %>"
                class="rounded-circle" style="width: 30px; height: 30px; object-fit: cover;" alt="Avatar"
                onerror="this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100'">
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
              <li class="px-3 py-2 border-bottom">
                <div class="fw-bold"><%= currUser.username %></div>
                <div class="small text-muted"><%= currUser.email %></div>
                <div class="badge bg-primary-subtle text-primary mt-1 text-uppercase"><%= currUser.role %></div>
              </li>
              <li><a class="dropdown-item py-2" href="/profile"><i class="fa-regular fa-user me-2"></i> Profile</a></li>
              <li><a class="dropdown-item py-2" href="/bookings"><i class="fa-solid fa-suitcase-rolling me-2"></i> My Bookings</a></li>
              <li><a class="dropdown-item py-2" href="/planner/my-trips"><i class="fa-solid fa-map-location-dot me-2"></i> AI Saved Plans</a></li>
              <% if (currUser.role === 'host' || currUser.role === 'admin') { %>
                <li><a class="dropdown-item py-2" href="/listings/new"><i class="fa-solid fa-plus me-2"></i> Create Listing</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item py-2 text-danger fw-bold" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout</a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/host/become-a-host">Host your stay</a>
          </li>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/signup">Sign up</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-outline-primary btn-sm rounded-pill px-3 ms-lg-2 fw-semibold" href="/login">Log in</a>
          </li>
        <% } %>

        <!-- Dark Mode Toggle -->
        <li class="nav-item ms-lg-2">
          <button class="btn btn-outline-secondary btn-sm rounded-circle p-2" id="theme-toggle" title="Toggle Theme" aria-label="Toggle Theme">
            <i class="fa-solid fa-moon"></i>
          </button>
        </li>
      </ul>
    </div>
  </div>
</nav>