<% layout("/layouts/boilerplate.ejs") -%>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">My Trips & Reservations</h2>
      <p class="text-muted">Manage your upcoming stays and review your past adventures.</p>
    </div>
    <a href="/listings" class="btn btn-outline-primary rounded-pill px-4">
      <i class="fa-solid fa-magnifying-glass me-1"></i> Explore More Stays
    </a>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="card p-5 text-center border-0 rounded-4 bg-subtle my-5">
      <i class="fa-solid fa-suitcase-rolling text-muted mb-3" style="font-size: 3rem;"></i>
      <h4 class="fw-bold">No trips booked yet</h4>
      <p class="text-muted">Ready to discover your next stay with StayNest?</p>
      <div class="d-flex justify-content-center gap-2 mt-2">
        <a href="/listings" class="btn btn-primary rounded-pill px-4 fw-bold">Explore Stays</a>
        <a href="/planner" class="btn btn-outline-secondary rounded-pill px-4">Use AI Planner</a>
      </div>
    </div>
  <% } else { %>
    <!-- Upcoming Stays -->
    <% if (upcoming.length > 0) { %>
      <h4 class="fw-bold mb-3"><i class="fa-solid fa-plane-departure text-primary me-2"></i>Upcoming Stays (<%= upcoming.length %>)</h4>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        <% for (let b of upcoming) { %>
          <div class="col">
            <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
              <% if (b.listing) { %>
                <img src="<%= b.listing.displayImage || (b.listing.image && b.listing.image.url) %>" class="card-img-top" style="height: 200px; object-fit: cover;" alt="<%= b.listing.title %>"
                  onerror="this.src='https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80'">
              <% } %>
              <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-success rounded-pill px-3 py-1 text-uppercase fw-bold"><%= b.status %></span>
                  <span class="fw-bold text-primary">₹ <%= b.totalPrice.toLocaleString("en-IN") %></span>
                </div>
                <h5 class="fw-bold mb-1"><%= b.listing ? b.listing.title : 'Property' %></h5>
                <p class="text-muted small mb-3">📍 <%= b.listing ? b.listing.location + ', ' + b.listing.country : '' %></p>
                
                <div class="p-3 bg-subtle rounded-3 small mb-3">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Dates:</span>
                    <span class="fw-semibold"><%= new Date(b.checkIn).toLocaleDateString() %> - <%= new Date(b.checkOut).toLocaleDateString() %></span>
                  </div>
                  <div class="d-flex justify-content-between">
                    <span class="text-muted">Duration:</span>
                    <span class="fw-semibold"><%= b.nights %> nights • <%= b.guestsCount %> guest<%= b.guestsCount > 1 ? 's' : '' %></span>
                  </div>
                </div>

                <div class="d-flex gap-2 mt-auto">
                  <a href="/bookings/<%= b._id %>" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold">
                    View Receipt
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Past & Cancelled Stays -->
    <% if (past.length > 0 || cancelled.length > 0) { %>
      <h4 class="fw-bold mb-3 text-muted"><i class="fa-solid fa-clock-rotate-left me-2"></i>Past & Cancelled</h4>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Property</th>
              <th>Host</th>
              <th>Dates</th>
              <th>Total</th>
              <th>Status</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% for (let b of [...past, ...cancelled]) { %>
              <tr>
                <td>
                  <span class="fw-bold"><%= b.listing ? b.listing.title : 'Property' %></span>
                  <div class="text-muted small">📍 <%= b.listing ? b.listing.location : '' %></div>
                </td>
                <td><%= b.host ? b.host.username : 'Host' %></td>
                <td><%= new Date(b.checkIn).toLocaleDateString() %> - <%= new Date(b.checkOut).toLocaleDateString() %></td>
                <td class="fw-semibold">₹ <%= b.totalPrice.toLocaleString("en-IN") %></td>
                <td>
                  <span class="badge <%= b.status === 'confirmed' ? 'bg-secondary' : 'bg-danger' %> rounded-pill text-uppercase">
                    <%= b.status %>
                  </span>
                </td>
                <td class="text-end">
                  <a href="/bookings/<%= b._id %>" class="btn btn-outline-secondary btn-sm rounded-pill">Details</a>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  <% } %>
</div>
