<% layout("/layouts/boilerplate.ejs") -%>

<div class="row justify-content-center my-4">
  <div class="col-lg-8">
    <div class="card border-0 rounded-4 shadow-lg overflow-hidden">
      <!-- Confirmation Banner -->
      <div class="p-4 p-md-5 text-white" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold text-uppercase mb-2">
              <%= booking.status %>
            </span>
            <h2 class="display-6 fw-bold mb-1">Reservation Confirmed</h2>
            <p class="lead opacity-90 mb-0">StayNest Reference: #<%= booking._id.toString().slice(-8).toUpperCase() %></p>
          </div>
          <button class="btn btn-outline-light rounded-pill px-3" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print Receipt
          </button>
        </div>
      </div>

      <div class="card-body p-4 p-md-5">
        <!-- Property Info Summary -->
        <% if (booking.listing) { %>
          <div class="d-flex align-items-center gap-4 pb-4 border-bottom">
            <img src="<%= booking.listing.displayImage || (booking.listing.image && booking.listing.image.url) %>" class="rounded-4 shadow-sm" style="width: 120px; height: 90px; object-fit: cover;" alt="<%= booking.listing.title %>"
              onerror="this.src='https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80'">
            <div>
              <h4 class="fw-bold mb-1">
                <a href="/listings/<%= booking.listing._id %>" class="text-dark text-decoration-none"><%= booking.listing.title %></a>
              </h4>
              <p class="text-muted mb-0"><i class="fa-solid fa-location-dot me-1 text-primary"></i><%= booking.listing.location %>, <%= booking.listing.country %></p>
            </div>
          </div>
        <% } %>

        <!-- Trip Details Grid -->
        <div class="row g-4 py-4 border-bottom">
          <div class="col-sm-6">
            <h6 class="text-uppercase text-muted fw-bold small">Dates</h6>
            <div class="fw-bold fs-6"><%= new Date(booking.checkIn).toLocaleDateString() %> → <%= new Date(booking.checkOut).toLocaleDateString() %></div>
            <div class="text-muted small"><%= booking.nights %> nights</div>
          </div>
          <div class="col-sm-6">
            <h6 class="text-uppercase text-muted fw-bold small">Guests</h6>
            <div class="fw-bold fs-6"><%= booking.guestsCount %> guest<%= booking.guestsCount > 1 ? 's' : '' %></div>
          </div>
          <div class="col-sm-6">
            <h6 class="text-uppercase text-muted fw-bold small">StayNest Host</h6>
            <div class="fw-bold"><%= booking.host ? booking.host.username : 'StayNest Host' %></div>
            <div class="text-muted small"><%= booking.host ? booking.host.email : '' %> • <%= booking.host ? booking.host.phone : '' %></div>
          </div>
          <div class="col-sm-6">
            <h6 class="text-uppercase text-muted fw-bold small">Guest</h6>
            <div class="fw-bold"><%= booking.guest ? booking.guest.username : 'Guest' %></div>
            <div class="text-muted small"><%= booking.guest ? booking.guest.email : '' %></div>
          </div>
        </div>

        <!-- Payment Breakdown Invoice -->
        <div class="py-4 border-bottom">
          <h5 class="fw-bold mb-3">Payment Details</h5>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Accommodation (<%= booking.nights %> nights)</span>
            <span class="fw-semibold">₹ <%= booking.basePrice.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Cleaning fee</span>
            <span class="fw-semibold">₹ <%= booking.cleaningFee.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">StayNest service fee (12%)</span>
            <span class="fw-semibold">₹ <%= booking.serviceFee.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-3">
            <span class="text-muted">Taxes & GST (18%)</span>
            <span class="fw-semibold">₹ <%= booking.taxPrice.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between fs-4 fw-bold border-top pt-3 text-dark">
            <span>Total Paid</span>
            <span class="text-primary">₹ <%= booking.totalPrice.toLocaleString("en-IN") %></span>
          </div>
        </div>

        <!-- Cancellation Actions -->
        <% if (booking.status === 'confirmed') { %>
          <div class="pt-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="text-muted small">Need to adjust plans? You can cancel up to check-in with your host.</div>
            <form action="/bookings/<%= booking._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking? Refund will be initiated.');">
              <button type="submit" class="btn btn-outline-danger rounded-pill px-4 btn-sm">
                Cancel Reservation
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
