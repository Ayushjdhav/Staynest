<% layout("/layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-md border-0 rounded-4 p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="brand-icon-box mx-auto mb-3">
          <i class="fa-solid fa-house-chimney-window"></i>
        </div>
        <h2 class="fw-bold">Create Account</h2>
        <p class="text-muted small">Join StayNest to discover and book extraordinary stays</p>
      </div>

      <form action="/signup" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold">Username</label>
          <input type="text" name="username" id="username" class="form-control rounded-3 py-2" placeholder="Choose a username" required>
          <div class="invalid-feedback">Please choose a username.</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label fw-semibold">Email Address</label>
          <input type="email" name="email" id="email" class="form-control rounded-3 py-2" placeholder="name@example.com" required>
          <div class="invalid-feedback">Please enter a valid email.</div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-semibold">Password</label>
          <input type="password" id="password" name="password" class="form-control rounded-3 py-2" placeholder="Create a secure password" minlength="4" required>
          <div class="invalid-feedback">Password must be at least 4 characters.</div>
        </div>

        <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold fs-6 shadow-sm mb-3">
          Create Account
        </button>

        <div class="text-center text-muted small">
          Already have an account? <a href="/login" class="text-primary fw-bold text-decoration-none">Log in</a>
        </div>
      </form>
    </div>
  </div>
</div>